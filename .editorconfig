root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4
# Existing files keep project usings first, then System.
dotnet_sort_system_directives_first = false
csharp_new_line_before_open_brace = all

[*.{csproj,props,targets,resx,settings}]
indent_style = space
indent_size = 2

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
